generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth (NextAuth / Auth.js) ---

enum Role {
  AGENCY_ADMIN
  CLIENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // hashed, used by Credentials provider
  role          Role      @default(CLIENT)
  storeId       String?
  store         Store?    @relation(fields: [storeId], references: [id])
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Domain: stores (clientes da agência) + orders + UTM attribution ---

model Store {
  id            String   @id @default(cuid())
  name          String
  shopifyDomain String   @unique // ex: minha-loja.myshopify.com
  webhookSecret String
  createdAt     DateTime @default(now())

  users  User[]
  orders Order[]
}

model Order {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shopifyOrderId  String
  orderNumber     String
  totalPrice      Float
  currency        String
  financialStatus String?
  customerEmail   String?
  createdAt       DateTime

  utm UtmAttribution?

  @@unique([storeId, shopifyOrderId])
  @@index([createdAt])
  @@index([storeId])
}

model UtmAttribution {
  id          String  @id @default(cuid())
  orderId     String  @unique
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  landingPage String?
  referrer    String?

  // "cart_attr" (captado pelo snippet) ou "landing_site_fallback"
  source      String

  @@index([utmSource])
  @@index([utmCampaign])
}
